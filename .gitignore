# =================================================
# Keep Files (Force include)
# =================================================

# Force include important empty directories
!uploads/.gitkeep
!logs/.gitkeep
!ml/models/.gitkeep
!ml/data/.gitkeep
!tests/.gitkeep

# Force include configuration templates
!config/settings.example.py
!.env.example
!docker-compose.example.yml

# Force include documentation
!docs/README.md
!docs/*.md

# =================================================
# End of .gitignore
# =================================================